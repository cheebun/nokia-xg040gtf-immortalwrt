# nokia-xg040gtf-immortalwrt: build only XG-040G-TF (UBI)
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_an4475-g2=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct-usb-sfp=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu-usb-sfp=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi-usb-sfp=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d=n
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi=y

# packages
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y

# kernel: BTF debug info + netkit
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_XDP_SOCKETS=y

# OpenSSL: built-in devcrypto engine
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_ENGINE_BUILTIN=y
CONFIG_OPENSSL_ENGINE_BUILTIN_DEVCRYPTO=y

# extra apps
CONFIG_PACKAGE_luci-app-appfilter=y
CONFIG_PACKAGE_luci-i18n-appfilter-zh-cn=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# remove argon
# CONFIG_PACKAGE_luci-theme-argon is not set

# vantage apps
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-app-vantage-traffic=y
# CONFIG_PACKAGE_luci-app-vantage-aps is not set

# socat
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_luci-app-socat=y
CONFIG_PACKAGE_luci-i18n-socat-zh-cn=y
